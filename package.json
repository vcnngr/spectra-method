{
  "name": "spectra-method",
  "version": "0.6.1",
  "description": "SPECTRA -- Security Protocol Engineering for Cyber Threat Response & Assessment. Multi-agent cybersecurity framework.",
  "type": "module",
  "bin": {
    "spectra": "cli/spectra-cli.js"
  },
  "main": "./cli/spectra-cli.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcnngr/spectra-method.git"
  },
  "scripts": {
    "validate": "python3 core/execution/validate-spectra.py --path .",
    "build:skill-index": "node scripts/build-skill-index.mjs",
    "test": "npm run test:validator && npm run test:execution && npm run test:smoke",
    "test:validator": "python3 core/execution/validate-spectra.py --path . --strict",
    "test:execution": "python3 -m unittest discover -s core/execution/tests -p 'test_*.py'",
    "test:scope": "npm run test:execution",
    "test:smoke": "node scripts/smoke-install.mjs"
  },
  "keywords": [
    "cybersecurity",
    "red-team",
    "blue-team",
    "pentest",
    "incident-response",
    "ai-agents",
    "claude",
    "codex",
    "spectra"
  ],
  "author": "SPECTRA",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "yaml": "^2.4.0"
  },
  "files": [
    "cli/",
    "core/",
    "!core/execution/e2e-test-report.md",
    "!**/__pycache__/",
    "!**/*.pyc",
    "scripts/",
    "docs/",
    "rtk/",
    "soc/",
    "irt/",
    "grc/",
    "_config/",
    "SPECTRA.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
